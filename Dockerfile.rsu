FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    mosquitto \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY v2x_logic.py .
COPY rsu.py .

RUN printf "listener 1883 0.0.0.0\nallow_anonymous true\npersistence false\nlog_dest stdout\n" > /app/mosquitto.conf

EXPOSE 80
EXPOSE 1883

CMD ["sh", "-c", "mosquitto -c /app/mosquitto.conf & sleep 1 && exec python3 -u rsu.py"]